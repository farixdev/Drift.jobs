# Drift runs with NO key (local scoring). Add a free Groq key for AI scoring
# and cover letters — get one at https://console.groq.com/keys
# You can also set all of this from the in-app ⚙ Settings dialog.

GROQ_API_KEY=your_key_here

# llama-3.1-8b-instant (fast, high limits) or llama-3.3-70b-versatile (sharper)
GROQ_MODEL=llama-3.1-8b-instant

# How many top matches to refine with AI per scan.
MAX_JOBS_TO_SCORE=15
